# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Local data and outputs
mock_vault/
memory/
*.json

# Test fixtures MUST be tracked even though *.json is globally ignored.
# These are golden outputs for the Phase 2 routing regression suite (E2).
!tests/routing/*.json
!tests/**/golden_*.json
!tests/**/fixture_*.json

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs and scratch
*.log
scratch/

# Runtime ephemera — not source (A4: Governance Foundation hardening)
alpha_output.txt
beta_output.txt
*_output.txt
dev/failed_routings/*.failed.md
dev/failed_routings/*.sidecar.json
dev/.uow_log/
dev/.uow_staging/

# Test-output artifacts produced by OutputRouter.apply() with timestamp
# filenames (rule_name_YYYYMMDDThhmmss_*.md). Real proposals use the
# ARCH-/DEV-/NLST- prefix convention and must NOT match these globs.
dev/proposals/boardroom_proposal_*.md
dev/proposals/technical_proposal_*.md
dev/proposals/council_decision_*.md
dev/proposals/.tmp_*
dev/handoffs/handoff_archival_*.md
dev/decisions/council_decision_*.md
dev/reports/

# Quarantine for reviewer-rejected work (kept locally, never committed)
dev/.cline_rejected_phase5/

# Boardroom scratch artefacts (verdict captures from /process responses)
scripts/.boardroom_*


# Handoff backups produced by scripts/replan_existing_handoffs.py --apply
dev/handoffs/*.bak.*.md

